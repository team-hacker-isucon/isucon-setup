# Manual server-side settings (trusted Bash; contains no credentials).
# Copy to ~/local/manual-settings.env, edit, then source in Bash.
# Do not upload the edited file to the public isucon-setup repository.
ISUCON_HOME=/home/isucon
SETUP_DIR="$ISUCON_HOME/isucon-setup"
ENV_DIR="$ISUCON_HOME/isucon-env"
ENV_REPO=git@github.com:team-hacker-isucon/isucon-env.git
ENV_REF=main
BRANCH=main
REMOTE="$ENV_REPO"

# ISUCON9 layout example. Change to the actual application's directory/unit.
# APP_DIR is relative to ISUCON_HOME; use . for an application in the home root.
APP_DIR=isucari/webapp/go
APP_SERVICE=isuapp.go.service
APP_BIN=isuapp
EXTRA_IGNORES=(xbuild/)
MAX_FILE_SIZE_MIB=50
MYSQL_CONF_DIR=/etc/mysql
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MYSQL_SLOW_LOG=/var/log/mysql/mysql-slow.log

# Set only if an additional login account exists (e.g. ubuntu).
ENTRY_USER=
